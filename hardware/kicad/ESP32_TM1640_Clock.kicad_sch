  (text "SEG CURRENT-LIMITING RESISTORS" (at 35 250 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 0e83432f-7eb1-544e-aa4a-2d387c03a515))
  (text "46-LED DISPLAY, NO DP: H1 H2 C1 M1 M2 C2 S1 S2" (at 35 295 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid a2607f89-c8ac-5443-83ac-9e40d4213203))
  (text "All cathodes connect to their assigned GRID. Never connect a digit common cathode directly to GND." (at 35 455 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 43a7c5fe-5d79-5aca-a5a3-107404786f1d))
  (text "+5V: U1 5V and U2 VDD. +3V3: A1 VCC and U3 VCC. A1 BL=GND. Common GND. C1/C2 next to U2." (at 35 465 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 910bda19-9484-5257-b541-1b45eaf45ba8))
  (text "SEG1...7 = a,b,c,d,e,f,g. Colon RAM values: 0x03 ON, 0x00 OFF. DP is omitted." (at 35 475 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid e5a75972-24d1-5057-86ae-c9170b6f0a91))
  (text "TM1640 SEG8 and GRID9...16 are not connected. No 74HCT245 is used in this variant." (at 35 485 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 10726973-540c-5f7e-ba25-6db073d57211))
  (text "A1 ST7789: 18/23/5/15/4, VCC=3V3, BL=GND. U3 DS3231: SDA21/SCL22, VCC=3V3, I2C 0x68." (at 35 495 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 4fb2248b-8212-5388-8a1e-880f00660408))
  (text "SW1: GPIO32 to GND. Short press selects city; hold 5 s opens Wi-Fi setup; internal pull-up enabled." (at 35 505 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 31d8f5ac-e43b-53a3-89df-73821d0d04bd))
